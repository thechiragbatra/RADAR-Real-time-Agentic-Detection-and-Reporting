# Copy to .env for local runs. Every RADAR_* value maps to radar/config.py.
RADAR_ENV=local
RADAR_DATA_DIR=data
RADAR_MODEL_URI=models
RADAR_AWS_REGION=ap-south-1

# Agent (Bedrock). Model access must be enabled in the Bedrock console for the region.
RADAR_BEDROCK_REGION=us-east-1
RADAR_BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
RADAR_PRICE_INPUT_PER_MTOK=1.0
RADAR_PRICE_OUTPUT_PER_MTOK=5.0

# Scoring service client (Lambdas); the ALB rejects requests without the key
RADAR_SCORER_URL=http://localhost:8000
RADAR_SCORER_API_KEY=
