FROM python:3.12-slim AS app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && useradd -r -u 10001 app \
    && mkdir -p /app/models \
    && chown app:app /app/models

USER app

FROM app AS model-builder
RUN mkdir -p /tmp/radar-data \
    && radar-simulate --out /tmp/radar-data --fraud-user-fraction 0.06 \
    && radar-train --data /tmp/radar-data --models /app/models --test-days 14 --promote \
    && rm -rf /tmp/radar-data

FROM app AS runtime
COPY --from=model-builder --chown=app:app /app/models /app/models

ENV RADAR_ENV=prod \
    RADAR_MODEL_URI=/app/models

CMD ["radar-serve"]
